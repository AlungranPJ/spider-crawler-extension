{
  "manifest_version": 3,
  "name": "Spider Crawler",
  "version": "1.0.0",
  "description": "A big IK-legged spider crawls any web page, bites the links you hunt for and wraps the rest in silk. Skins, 8-bit mode, optional Jev AI judging.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.typesafe.ai/*",
    "https://openrouter.ai/*",
    "https://api.venice.ai/*",
    "https://opencode.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Spider Crawler",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
